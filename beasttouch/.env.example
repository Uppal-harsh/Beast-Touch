# Set this to the final HTTPS origin before deployment (no trailing path).
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional Google integrations. Analytics loads only after a visitor opts in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# Contact API: all three values are required for email delivery.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
